APP_ENV=development
HOST=127.0.0.1
PORT=8000
DATABASE_URL=sqlite+aiosqlite:///./database/velang.db
SESSION_SECRET=change-me-before-production
COOKIE_SECURE=false

# Point this domain's A record (and optional AAAA record) to your public server first.
DOMAIN=shop.example.com

# Google Identity / Sign in with Google.
# Use the Web client ID from your Google Auth Platform project.
GOOGLE_WEB_CLIENT_ID=

# Long random bootstrap secret used once to pair a trusted Android admin installation.
ADMIN_PAIRING_KEY=
# Comma-separated emails allowed to administer through Google web sign-in.
ADMIN_EMAILS=you@example.com
ADMIN_SESSION_DAYS=14

# dev keeps payments locally testable. Switch after the merchant flow is actually configured.
PAYMENT_PROVIDER=dev
GOOGLE_PAY_MERCHANT_VPA=
GOOGLE_PAY_MERCHANT_NAME=Velang

# Reserved for a future Google Cloud Storage media backend.
GCS_BUCKET=
GCS_PROJECT_ID=

# Local-only authentication shortcut. Automatically unavailable in production.
DEV_AUTH=false
